# Repo-root local secrets. NEVER commit the real file (.env and *.env are gitignored).
# Canonical source of truth is the Supabase project (project ref zvohdvopmvzsujktrdmu):
# every value here must match what the platform holds for that project.
#
# Required by repo tooling (scripts/*):
SUPABASE_ACCESS_TOKEN=           # Supabase personal access token (Management API + CLI auth)
SUPABASE_PROJECT_REF=zvohdvopmvzsujktrdmu
CRON_SECRET=                     # must equal `supabase secrets list` CRON_SECRET on the project
#                            (== content of .cron-secret.txt, a gitignored repo-root store)
# Optional — scripts derive it from the project ref if absent:
SUPABASE_URL=https://zvohdvopmvzsujktrdmu.supabase.co

# Optional — dead-man's switch heartbeat (health-checks.io ping URL). Project secret
# HEALTHCHECKS_PING_URL; store the value locally here only (gitignored).
HEALTHCHECKS_PING_URL=

# Optional — support-chat AI-cost gate knobs (project secrets on the platform):
AI_GUEST_POOL_DAILY=            # daily USD wall for ALL anonymous visitors (default 0.10)
AI_CHAT_DAILY_CAP=              # logged-in chat daily message count (default 100)
#                            (SUPABASE_SERVICE_ROLE_KEY for local scripts lives in .env, gitignored)

# PayPal — one-time checkout (Orders v2). Values are Project Secrets on the
# Supabase project; the local copy here is only for tooling that sets them.
# Get client id + secret from developer.paypal.com -> Apps & Credentials.
# Keep PAYPAL_ENV=sandbox until a real sandbox capture AND refund are proven.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CHECKOUT_ENABLED=false   # server gate: must be "true" before any order is minted
# Public by design: the browser SDK needs the client id at build time (Vercel env too).
VITE_PAYPAL_CLIENT_ID=
# Validate after editing: node scripts/env-audit.mjs   (read-only, never writes)